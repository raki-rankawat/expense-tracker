# Copy to .env at the repository root and adjust. .env is gitignored and is
# never baked into an image; docker compose reads it for local development.
# Production values live only in Render's environment configuration.

# Runtime mode for both apps: development locally, production on Render.
NODE_ENV=development

# Host port the backend (Express) is published on: http://localhost:4000
BACKEND_PORT=4000

# Host port the frontend (Vite dev server) is published on: http://localhost:5173
FRONTEND_PORT=5173

# Port MongoDB listens on inside the Compose network. It is not published to
# the host by default (feature 02).
MONGO_PORT=27017

# Connection string the backend uses. Uses the Compose service name "mongo",
# never localhost. Production points at a separate database (feature 06).
MONGODB_URI=mongodb://mongo:27017/expense_tracker
